            "processing_timestamp": "<DATE>"
        }
    }
}
]]></template>
        <notes>Wohlgeformtes JSON mit vollständiger Dokumentstruktur</notes>
    </format>

    <!-- YAML Output Template (neu) -->
    <format id="yaml_output">
        <name>YAML Document</name>
        <extension>.yaml</extension>
        <mime_type>application/yaml</mime_type>
        <template><![CDATA[
---
document:
  metadata:
    title: "<TITLE>"
    author: "<AUTHOR>"
    date: "<DATE>"
    generator: "Output Prompt System v1.7"
    format: "YAML"
    encoding: "UTF-8"
  content: "<CONTENT>"
  system_info:
    version: "1.7"
    schema_valid: true
    processing_timestamp: "<DATE>"
...
]]></template>
        <notes>YAML-Dokument mit klarer Struktur für Konfiguration und Daten</notes>
    </format>
</format_definitions>

