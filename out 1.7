Zeilenumbruch: LF (Unix)
]]></template>
        <notes>Einfacher Text mit UTF-8 Kodierung, geeignet für alle Systeme</notes>
    </format>

    <!-- XML Output Template -->
    <format id="xml_output">
        <name>XML Document</name>
        <extension>.xml</extension>
        <mime_type>application/xml</mime_type>
        <template><![CDATA[
<?xml version="1.0" encoding="UTF-8"?>
<document xmlns="http://output-prompt-system/v1.7">
    <metadata>
        <title><TITLE></title>
        <author><AUTHOR></author>
        <date><DATE></date>
        <generator>Output Prompt System v1.7</generator>
        <created><DATE></created>
        <format>XML</format>
        <encoding>UTF-8</encoding>
    </metadata>
    <content>
        <CONTENT>
    </content>
    <system_info>
        <version>1.7</version>
        <schema_valid>true</schema_valid>
        <processing_timestamp><DATE></processing_timestamp>
    </system_info>
</document>
]]></template>
        <notes>Wohlgeformtes XML mit Namespace und vollständiger Metadatenstruktur</notes>
    </format>

    <!-- JSON Output Template (neu) -->
    <format id="json_output">
        <name>JSON Document</name>
        <extension>.json</extension>
        <mime_type>application/json</mime_type>
        <template><![CDATA[
{
    "document": {
        "metadata": {
            "title": "<TITLE>",
            "author": "<AUTHOR>",
            "date": "<DATE>",
            "generator": "Output Prompt System v1.7",
